      "parameters": {
        "language": "python",
        "pythonCode": "combined_updates = []\n\nfor item in items:\n    date = item['json'].get('Date', '')\n    email = item['json'].get('Email', 'Unknown')\n    content = item['json'].get('Content', '[No update]')\n    \n    update = f\"Date: {date}\\nFrom: {email}\\nUpdate:\\n{content}\"\n    combined_updates.append(update)\n\ncombined_text = \"\\n\\n\".join(combined_updates)\n\nreturn [{\n    \"json\": {\n        \"all_updates\": combined_text\n    }\n}]\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -80,
        -160
