      "parameters": {
        "language": "python",
        "pythonCode": "from datetime import datetime\n\n# Get team progress from input\nteam_progress_data = items[0]['json'].get('team progress', '')\n\n# Handle both dict and string types\nif isinstance(team_progress_data, dict):\n    team_progress = team_progress_data.get('team_progress', '').strip()\nelif isinstance(team_progress_data, str):\n    team_progress = team_progress_data.strip()\nelse:\n    team_progress = ''\n\n# Fallback if no progress is available\nif not team_progress:\n    team_progress = \"No intern updates received today.\"\n\n# Format date\ntoday = datetime.now().strftime(\"%B %d, %Y\")  # e.g. April 21, 2025\n\n# Construct the email body\nemail_body = f\"\"\"\nHello Team,\n\nThe intern updates have been successfully recorded in the Google Sheet for {today}.\n\n\n{team_progress}\n\nYou can view the full updates here:\nhttps://docs.google.com/spreadsheets/d/1HJan-dk6-nPtXk15cvkMXqTwtS8Xf1v7XBbIgaBZ9vo/edit?gid=0#gid=0\n\nRegards,  \nDZ AI Agent\n\"\"\"\n\n# Return the email body to the next node\nreturn [{\n    \"json\": {\n        \"email_body\": email_body\n    }\n}]\n"
      },
