      "parameters": {
        "language": "python",
        "pythonCode": "# Combine intern summaries into a single formatted string\nsummaries = []\n\nfor item in items:\n    name = item['json'].get('Name ', '').strip()\n    summary = item['json'].get('Summary', '').strip()\n    if name and summary:\n        summaries.append(f\"- {name}: {summary}\")\n\ncombined = \"\\n\".join(summaries)\n\nreturn [{\n    \"json\": {\n        \"combinedSummaries\": combined\n    }\n}]\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1000,
        -160
      ],
      "id": "b7c0c718-9af9-403d-b329-f1aa6236914a",
      "name": "Combine/Merge Summary"
    },
    {
      "parameters": {
        "language": "python",
        "pythonCode": "import re\n\n# Get AI response\ntext = items[0]['json'].get('team progress', '')\n\n# Remove any code block markers like ```json or ``` or ```\ntext = re.sub(r\"```[a-z]*\\n?\", \"\", text, flags=re.IGNORECASE)\ntext = re.sub(r\"```\", \"\", text)\n\n# Intern names to detect and keep in the output\nintern_names = [\"Indhu\", \"Bhavya\", \"Akash\"]\n\n# Split into sentences\nsentences = re.split(r'(?<=[.!?])\\s+', text)\n\n# Filter sentences that mention any intern name\nfiltered = [s for s in sentences if any(name.lower() in s.lower() for name in intern_names)]\n\n# Function to clean and keep intern names\ndef keep_names(sentence):\n    # Ensure intern names appear properly formatted in the sentence\n    for name in intern_names:\n        sentence = re.sub(rf'\\b{name}\\b', name, sentence, flags=re.IGNORECASE)\n    return sentence.strip(\" ,.-\")\n\n# Format each line as a clean bullet point with intern names\nfinal_lines = [f\" - {keep_names(s)}\" for s in filtered]\n\n# Final output without any curly braces or extraneous characters\nclean_output = \"Interns Progress:\\n\" + \"\\n\".join(final_lines)\n\n\n# Return the result with intern names included and no curly braces\nreturn [{\n    'json': {\n        'team progress': clean_output.strip()\n    }\n}]\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1780,
