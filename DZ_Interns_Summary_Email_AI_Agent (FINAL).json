    {
      "parameters": {
        "language": "python",
        "pythonCode": "import json\nimport re\n\n# Get the raw AI output\nai_output = items[0]['json'].get('output', '').strip()\n\n# Remove triple backticks and 'json' tag (if present)\ncleaned_output = re.sub(r'^```json|^```|```$', '', ai_output.strip(), flags=re.MULTILINE).strip()\n\n# Debug: Check if output is empty\nif not cleaned_output:\n    raise ValueError(\"AI output is empty after cleaning. Cannot parse JSON.\")\n\n# Try to parse cleaned JSON\ntry:\n    data = json.loads(cleaned_output)\nexcept json.JSONDecodeError as e:\n    raise ValueError(f\"Failed to parse AI output:\\n{cleaned_output}\") from e\n\n# Convert into n8n format for further use\nresult = []\n\n# Ensure 'summaries' is a list of dictionaries\nsummaries = data.get('summaries', [])\nif isinstance(summaries, list):\n    for entry in summaries:\n        if isinstance(entry, dict):\n            result.append({\n                'json': {\n                    'Name': entry.get('name', ''),\n                    'Date': entry.get('date', ''),\n                    'Summary': entry.get('summary', '')\n                }\n            })\n        else:\n            raise ValueError(f\"Expected a dictionary but got {type(entry)}.\")\nelse:\n    raise ValueError(f\"Expected 'summaries' to be a list but got {type(summaries)}.\")\n\n# Return the final result\nreturn result\n"
      },
